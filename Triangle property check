#include<iostream>
using namespace std;
int main(){
    int a,b,c;
    cin>>a>>b>>c;
    if(a+b>c || b+c>a || c+a>>b){
        cout<<"Valid Triangle can be form"<<endl;
    }else{
        cout<<"Not valid"<<endl;
    }
    if(a==b && b==c ){
        cout<<"Euilateral"<<endl;
    }
    else if(a==b || b==c || c==a){
        cout<<"Isosceles"<<endl;
    }else{
        cout<<"Scalene";
    }
    
    return 0;
}
