#include<iostream>
using namespace std;
int main(){
   int unit;
   cin>>unit;
   int bill;
   if(unit<=100){
       bill=(unit*1.5);
   }
   if(unit>100 && unit<=300){
       bill=(100*1.5)+(unit-100)*2.5;
   }
   else{
       bill=100*1.5 + 200*2.5 + (unit-200)*4;
   }
   cout<<bill+bill*.15;
    
    return 0;
}
